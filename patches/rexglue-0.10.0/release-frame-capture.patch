+  {
+    static const bool capture = !rex::cvar::GetFlagByName("perf_log_csv").empty();
+    static const bool title_fps = rex::cvar::Query<bool>("majin_window_fps");
+    [[maybe_unused]] static const bool announced = [] {
+      REXGPU_INFO("[Majin performance] Release counter mode: csv={} window_title={} title_flag={}",
